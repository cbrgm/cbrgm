{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "dependencyDashboard": true,
  "description": [
    "Preset used in all of my personal projects"
  ],
  "extends": [
    "config:recommended",
    ":rebaseStalePrs",
    ":semanticCommits",
    "helpers:pinGitHubActionDigests"
  ],
  "minimumReleaseAge": "3 days",
  "dockerfile": {
    "pinDigests": false
  },
  "gomod": {
    "postUpdateOptions": [
      "gomodUpdateImportPaths",
      "gomodTidy"
    ]
  },
  "customManagers": [
    {
      "description": "Update Golang in .go-version file",
      "customType": "regex",
      "fileMatch": [
        "(^|/)\\.go-version$"
      ],
      "matchStrings": [
        "^\\s*(?<currentValue>.+?)\\s*$"
      ],
      "depNameTemplate": "golang",
      "datasourceTemplate": "golang-version"
    }
  ],
  "packageRules": [
    {
      "description": "Major updates: individual PRs, reviewed manually",
      "matchUpdateTypes": [
        "major"
      ],
      "semanticCommitType": "chore",
      "semanticCommitScope": "deps",
      "automerge": false
    },
    {
      "description": "Minor updates: grouped and automerged",
      "groupName": "minor versions",
      "matchUpdateTypes": [
        "minor"
      ],
      "semanticCommitType": "chore",
      "semanticCommitScope": "deps",
      "automerge": true
    },
    {
      "description": "Patch updates: grouped and automerged",
      "groupName": "patch versions",
      "matchUpdateTypes": [
        "patch"
      ],
      "semanticCommitType": "chore",
      "semanticCommitScope": "deps",
      "automerge": true
    },
    {
      "description": "Automerge docker updates",
      "groupName": "docker digests",
      "matchDatasources": [
        "docker"
      ],
      "semanticCommitType": "chore",
      "semanticCommitScope": "deps",
      "pinDigests": false,
      "automerge": true
    },
    {
      "description": "Automerge untagged go libs",
      "groupName": "untagged libraries",
      "matchPackageNames": [
        "golang.org/x/crypto",
        "golang.org/x/net"
      ],
      "semanticCommitType": "chore",
      "semanticCommitScope": "deps",
      "automerge": true
    },
    {
      "matchDatasources": [
        "golang-version"
      ],
      "rangeStrategy": "replace"
    },
    {
      "extractVersion": "^(?<version>v?\\d+\\.\\d+\\.\\d+)$",
      "versioning": "regex:^v?(?<major>\\d+)(\\.(?<minor>\\d+)\\.(?<patch>\\d+))?$"
    },
    {
      "description": "Only update GitHub Actions on minor/major version changes",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "digest",
        "patch"
      ],
      "enabled": false
    },
    {
      "description": "Build tool version upgrades",
      "groupName": "build tools",
      "matchManagers": [
        "github-actions"
      ],
      "semanticCommitType": "ci",
      "semanticCommitScope": "tools",
      "automerge": true
    }
  ],
  "labels": [
    "renovate"
  ],
  "ignoreDeps": [
    "github.com/prometheus/prometheus"
  ]
}
